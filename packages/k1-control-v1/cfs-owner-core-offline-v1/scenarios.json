  "synthetic_only": true,
  "scenarios": [
    {
      "id": "s12_snapshot_requests_stock_owner_exclusion",
      "expected": {
        "verdict": "pass_offline",
        "phase": "lease_pending",
        "saved_stock_auto_refill": 1,
        "pending_operations": ["exclude_stock_auto_refill"]
      }
    },
    {
      "id": "lease_activates_only_after_verified_exclusion",
