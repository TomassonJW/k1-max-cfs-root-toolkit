      "expected_snapshot": {
        "print_state": "standby",
        "box_state": "connect",
        "connected_cfs_units": ["T1"],
        "active_cfs_command": "",
        "engaged_routes": ["T1A"],
        "extruder_target_c": 0.0,
        "bed_target_c": 0.0,
        "toolhead_filament_present": true
      }
    },
    {
      "id": "disabled_toolhead_sensor",
      "fixture": "fixtures/disabled-toolhead-sensor.json",
      "expected_snapshot": {
        "print_state": "standby",
        "box_state": "connect",
        "connected_cfs_units": ["T1", "T2"],
