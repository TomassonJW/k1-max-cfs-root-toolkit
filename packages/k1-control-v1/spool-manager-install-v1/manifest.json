    "path": "/usr/data/k1-control-v1/state/nginx-active.conf",
    "anchor": "        location ~ ^/(access|api|machine|printer|server)/ {\n",
    "block": "        # K1 Control spool manager (document 102, ADR-075): a write to the CFS\n        # can outlast nginx's 60 s default and the window waits 65 s for it.\n        # `^~` keeps the regex location below from taking these requests.\n        location ^~ /machine/k1_control/spools/ {\n            proxy_pass http://k1_moonraker;\n            proxy_read_timeout 90s;\n            proxy_set_header Host $http_host;\n            proxy_set_header X-Real-IP 127.0.0.1;\n            proxy_set_header Authorization \"\";\n        }\n\n"
  },
