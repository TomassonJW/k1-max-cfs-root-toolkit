{
  "schema": 1,
  "name": "K1_CONTROL_CREATE_EXACT_THERMAL_11X11_PROFILE",
  "status": "OFFLINE_UI_AND_SEQUENCE_CONTRACT_ONLY",
  "entrypoint": {
    "surface": "K1 Control",
    "visible_action": "Calibrer ce couple de températures",
    "one_click_after_human_preconditions": true,
    "mainsail_micro_authorization_required": false
  },
  "inputs": [
    "plate_id",
    "bed_first_c",
    "nozzle_first_c",
    "profile_label"
  ],
  "human_preconditions": [
    "filament_fully_unloaded",
    "nozzle_freshly_cleaned",
    "bed_surface_clean_and_clear"
  ],
  "automatic_sequence": [
    "prove_no_route_and_both_filament_sensors_clear",
    "heat_probe_nozzle_to_140C_without_filament",
